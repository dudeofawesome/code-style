// In order to update the config, update @code-style/typescript-configs
{
  "extends": [
    "@code-style/typescript-configs/roles/node",
    "@code-style/typescript-configs/layers/esmodule",
    "@code-style/typescript-configs/layers/library"
  ],
  "compilerOptions": {
    "rootDir": "./",
    "baseUrl": "src/",
    "outDir": "dist/",
    // eslint-plugin-import-x's bundled types reference packages it doesn't declare
    "skipLibCheck": true
  },
  "include": ["./"],
  "exclude": ["dist/", "coverage/"]
}
