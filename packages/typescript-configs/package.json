{
  "name": "@code-style/typescript-configs",
  "version": "2.0.0-32",
  "description": "My Typescript configs",
  "keywords": [
    "typescript",
    "tsconfig"
  ],
  "homepage": "https://github.com/dudeofawesome/code-style/blob/main/packages/typescript-configs/README.md",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dudeofawesome/code-style.git",
    "directory": "/packages/typescript-configs"
  },
  "license": "MIT",
  "author": "Louis Orleans <louis@orleans.io>",
  "type": "module",
  "exports": {
    ".": "./roles/base.json",
    "./roles/*": "./roles/*.json",
    "./layers/*": "./layers/*.json",
    "./roles/*.json": "./roles/*.json",
    "./layers/*.json": "./layers/*.json",
    "./*.json": "./*.json"
  },
  "main": "roles/base.json",
  "files": [
    "./roles/",
    "./layers/"
  ],
  "scripts": {
    "lint": "concurrently --raw --group 'npm:lint:*'",
    "lint:js": "eslint . --ext ts,json --cache",
    "lint:types": "tsc --noEmit --pretty",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules $NODE_OPTS\" jest",
    "test:debug": "NODE_OPTS='--inspect-brk' npm run test -- --runInBand"
  },
  "dependencies": {
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.6.3",
    "@types/react": "^18.2.23",
    "jest": "^29.7.0",
    "tsx": "^4.9.4",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
