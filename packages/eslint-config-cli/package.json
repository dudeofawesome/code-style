{
  "name": "@code-style/eslint-config-cli",
  "version": "2.0.0-32",
  "description": "My CLI ESLint config",
  "keywords": [
    "style",
    "lint",
    "config",
    "eslint"
  ],
  "homepage": "https://github.com/dudeofawesome/code-style/blob/main/packages/eslint-config-cli/README.md",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dudeofawesome/code-style.git",
    "directory": "/packages/eslint-config-cli"
  },
  "license": "MIT",
  "author": "Louis Orleans <louis@orleans.io>",
  "exports": {
    ".": "./base.yaml",
    "./base": "./base.yaml",
    "./*.yaml": "./*.yaml"
  },
  "main": "base.yaml",
  "files": [
    "./base.yaml"
  ],
  "scripts": {
    "lint": "concurrently --raw --group 'npm:lint:*'",
    "lint:js": "eslint . --ext ts,json --cache",
    "lint:types": "tsc --noEmit --pretty",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules $NODE_OPTS\" jest",
    "test:debug": "NODE_OPTS='--inspect-brk' npm run test -- --runInBand"
  },
  "devDependencies": {
    "@types/eslint": "^8.44.2",
    "@types/node": "^20.6.3",
    "tsx": "^4.9.4"
  },
  "peerDependencies": {
    "eslint": "^8.49.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
