{
  "name": "@code-style/eslint-config",
  "version": "2.0.0-35",
  "description": "My base ESLint config",
  "keywords": [
    "style",
    "lint",
    "config",
    "eslint"
  ],
  "homepage": "https://github.com/dudeofawesome/code-style/blob/main/packages/eslint-config/README.md",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dudeofawesome/code-style.git",
    "directory": "/packages/eslint-config"
  },
  "license": "MIT",
  "author": "Louis Orleans <louis@orleans.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./lenient": {
      "types": "./dist/lenient.d.ts",
      "default": "./dist/lenient.js"
    },
    "./rule-sets/*": {
      "types": "./dist/rule-sets/*.d.ts",
      "default": "./dist/rule-sets/*.js"
    },
    "./overrides/*": {
      "types": "./dist/overrides/*.d.ts",
      "default": "./dist/overrides/*.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/base.js",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "concurrently --raw --group 'npm:build:*'",
    "build:js": "esbuild --tsconfig=tsconfig.build.json $(glob 'src/**/*.?(c|m)[jt]s' --ignore '**/*.@(spec|test).*') --outdir=dist --sourcemap=inline --platform=node --target=node20 --format=esm",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "check": "concurrently --raw --group 'npm:test' 'npm:lint'",
    "lint": "concurrently --raw --group 'npm:lint:*'",
    "lint:js": "eslint . --cache",
    "lint:types": "tsc --noEmit --pretty",
    "prepublishOnly": "npm run build",
    "test": "node $NODE_OPTS --import=tsx --test $(glob --ignore '**/node_modules/**' --ignore '**/dist/**' '**/*[.-_]test.?(c|m)[jt]s' '**/test?(-*).?(c|m)[jt]s' '**/test/**/*.?(c|m)[jt]s')",
    "test:debug": "NODE_OPTS='--inspect-brk' npm run test"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.0",
    "@eslint/js": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-json-files": "^5.1.0",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^16.0.0"
  },
  "devDependencies": {
    "@code-style/code-style": "^2.0.0-35",
    "@code-style/eslint-config": "^2.0.0-32",
    "@code-style/eslint-config-cli": "^2.0.0-35",
    "@code-style/eslint-config-esmodule": "^2.0.0-35",
    "@code-style/eslint-config-node": "^2.0.0-35",
    "@code-style/eslint-config-typescript": "^2.0.0-35",
    "@code-style/typescript-configs": "^2.0.0-35",
    "@types/node": "^20.12.11",
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.1",
    "eslint": "^10.0.0",
    "glob": "^10.3.14",
    "tsx": "^4.9.4",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
