{
  "name": "@code-style/stylelint-config",
  "version": "2.0.0-32",
  "description": "My stylelint configs",
  "keywords": [
    "stylelint",
    "style",
    "css",
    "lint",
    "config"
  ],
  "homepage": "https://github.com/dudeofawesome/code-style/blob/main/packages/stylelint-config/README.md",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dudeofawesome/code-style.git",
    "directory": "/packages/stylelint-config"
  },
  "license": "MIT",
  "author": "Louis Orleans <louis@orleans.io>",
  "type": "module",
  "exports": {
    ".": "./dist/base.js",
    "./base": "./dist/base.js"
  },
  "main": "dist/base.js",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "concurrently --raw --group 'npm:build:*'",
    "build:js": "esbuild --tsconfig=tsconfig.build.json $(glob 'src/**/*.?(c|m)[jt]s' --ignore '**/*.@(spec|test).*') --outdir=dist --sourcemap=inline --platform=node --target=node18 --format=esm",
    "build:types": "# tsc --project tsconfig.build.json --emitDeclarationOnly",
    "lint": "concurrently --raw --group 'npm:lint:*'",
    "lint:js": "eslint . --ext ts,json --cache",
    "lint:types": "tsc --noEmit --pretty",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules $NODE_OPTS\" jest",
    "test:debug": "NODE_OPTS='--inspect-brk' npm run test -- --runInBand"
  },
  "dependencies": {
    "stylelint": "^16.5.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.4",
    "tsx": "^4.9.4"
  },
  "peerDependencies": {
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
