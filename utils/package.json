{
  "name": "@code-style/utils",
  "version": "2.0.0-35",
  "private": true,
  "type": "module",
  "exports": {
    "./path": "./path.ts",
    "./testing/eslint": "./testing/eslint/index.ts",
    "./testing/eslint/*": "./testing/eslint/*.ts",
    "./testing/stylelint": "./testing/stylelint/index.ts",
    "./testing/stylelint/*": "./testing/stylelint/*.ts",
    "./testing/assert/*": "./testing/assert/*.ts"
  },
  "scripts": {
    "lint": "concurrently --raw --group \"npm:lint:*\"",
    "lint:js": "eslint .",
    "lint:types": "tsc --noEmit --pretty",
    "test": "node $NODE_OPTS --import=tsx --test $(glob --ignore '**/node_modules/**' --ignore '**/dist/**' '**/*[.-_]test.?(c|m)[jt]s' '**/test?(-*).?(c|m)[jt]s' '**/test/**/*.?(c|m)[jt]s')",
    "test:debug": "NODE_OPTS='--inspect-brk' npm run test"
  },
  "dependencies": {
    "eslint": "^10.0.0",
    "stylelint": "^16.3.1"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "common-tags": "^1.8.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
